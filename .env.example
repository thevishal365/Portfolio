# GoatCounter visitor analytics (https://www.goatcounter.com)
#
# Copy this file to ".env.local" in the project root and fill in your own
# values. ".env.local" is matched by *.local in .gitignore and will never
# be committed. Restart the dev server / rebuild after changing it.

# Your GoatCounter site code: https://<SITE_CODE>.goatcounter.com
VITE_GOATCOUNTER_SITE=

# GoatCounter API token: account settings -> API -> generate
VITE_GOATCOUNTER_API_TOKEN=
